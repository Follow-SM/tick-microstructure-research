# ENTERPRISE key for /ws/v1/toxicity and /ws/v1/confluence: https://follow-sm.com/pricing
# Never commit a real key. Without one, run `tmr collect --venues-only`.
FOLLOWSM_API_KEY=

# Binance symbols to capture. BTC/ETH/SOL/XRP also get Polymarket Up/Down ground truth.
TMR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT

TMR_DATA_DIR=data
TMR_RESULTS_DIR=results
TMR_OUTREACH_DIR=outreach
